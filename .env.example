# Gateway (Plat5 edge)
VITE_GATEWAY_URL=http://localhost:5001

# Plat5 Auth (OIDC issuer)
VITE_AUTH_ISSUER=http://localhost:5000
VITE_AUTH_CLIENT_ID=plat5
VITE_AUTH_REDIRECT_URI=http://localhost:5173/callback

# Optional audience (OpenAuth authorize param). Leave empty if unused.
# VITE_AUTH_AUDIENCE=plat5

# API key brand (must match plat5.yml apikey_brand / APIKEY_BRAND). Keys {brand}-sk-1- / {brand}-mk-1-
# VITE_APIKEY_BRAND=plat5
